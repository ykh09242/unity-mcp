#!/usr/bin/env bash
# Pre-push hook: runs the local Unity-version parity check in compile-only mode.
# Installed by tools/install-hooks.sh; opt-in (devs without the hook see no behavior change).
# To bypass for a single push: git push --no-verify

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
SCRIPT="${REPO_ROOT}/tools/check-unity-versions.sh"
HEAD_SHA="$(git rev-parse --verify HEAD)"
# Include checker, package and project configuration consumed by compilation.
inputs=(MCPForUnity TestProjects/UnityMCPTests/Assets TestProjects/UnityMCPTests/Packages
  TestProjects/UnityMCPTests/ProjectSettings tools/check-unity-versions.sh
  tools/unity-versions.json tools/hooks/pre-push .github/workflows/unity-tests.yml)

refuse() {
  echo "pre-push: $*" >&2
  exit 1
}

clean_inputs() {
  local dirty flags entry ignored
  flags="$(git ls-files -v -- "${inputs[@]}")" || refuse "cannot inspect input index flags."
  while IFS= read -r entry; do
    case "$entry" in
      [a-zS]' '*) refuse "relevant inputs may be dirty: assume-unchanged or skip-worktree hides source; clear those flags before validating $HEAD_SHA." ;;
    esac
  done <<< "$flags"
  # Git ignore rules do not stop Unity importing local compilation inputs.
  # Only this generated resolution result is exempt; the tracked manifest stays clean.
  # Dependency-environment reproducibility is outside this local source-SHA check.
  ignored="$(git ls-files --others --ignored --exclude-standard -- "${inputs[@]}" \
    ':(top,exclude,literal)TestProjects/UnityMCPTests/Packages/packages-lock.json')" \
    || refuse "cannot inspect ignored compilation inputs."
  [[ -z "$ignored" ]] || refuse "ignored relevant files are present; preserve them outside compilation inputs before validating $HEAD_SHA."
  # Avoid refreshing/writing the index; include staged, unstaged and untracked inputs.
  dirty="$(git --no-optional-locks status --porcelain --untracked-files=all -- "${inputs[@]}")" \
    || refuse "cannot inspect relevant inputs."
  [[ -z "$dirty" ]] || refuse "relevant inputs are dirty; commit or preserve them elsewhere before validating $HEAD_SHA."
  [[ "$(git rev-parse --verify HEAD)" == "$HEAD_SHA" ]] || refuse "HEAD changed during validation."
}

# stdin format from git: <local-ref> <local-sha> <remote-ref> <remote-sha> (one line per ref being pushed)
relevant=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "$local_sha" && -n "$remote_sha" ]] || refuse "invalid pre-push ref record."
  [[ "$local_sha" =~ ^0+$ ]] && continue
  git cat-file -e "${local_sha}^{commit}" 2>/dev/null || refuse "cannot inspect pushed commit $local_sha."

  if [[ "$remote_sha" =~ ^0+$ ]]; then
    # Without a known base inspect the entire immutable input tree.
    base=$(git merge-base "$local_sha" origin/beta 2>/dev/null \
        || git merge-base "$local_sha" origin/main 2>/dev/null \
        || true)
    if [[ -z "$base" ]]; then
      names="$(git ls-tree -r --name-only "$local_sha" -- "${inputs[@]}")" \
        || refuse "cannot inspect new ref $local_ref."
      [[ -n "$names" ]] || continue
    else
      if git diff --quiet "$base" "$local_sha" -- "${inputs[@]}"; then continue
      else result=$?; [[ $result -eq 1 ]] || refuse "cannot inspect $local_ref."; fi
    fi
  else
    if git diff --quiet "$remote_sha" "$local_sha" -- "${inputs[@]}"; then continue
    else result=$?; [[ $result -eq 1 ]] || refuse "cannot inspect remote base for $local_ref."; fi
  fi

  [[ "$local_sha" == "$HEAD_SHA" ]] \
    || refuse "$local_ref pushes $local_sha but checkout HEAD is $HEAD_SHA; check out the pushed commit first."
  relevant=1
done

if [[ $relevant -eq 0 ]]; then
  echo "pre-push: no Unity-relevant changes detected; skipping check."
  exit 0
fi

clean_inputs
[[ -x "$SCRIPT" ]] || refuse "checker missing or not executable: $SCRIPT."
echo "pre-push: checking pushed SHA $HEAD_SHA (local compile-only; unavailable Unity versions may skip)."
"$SCRIPT" --pre-push
clean_inputs
echo "pre-push: checker completed for pushed SHA $HEAD_SHA."
