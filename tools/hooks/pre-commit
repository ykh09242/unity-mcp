#!/usr/bin/env bash
# Pre-commit hook: regenerate the Docusaurus tool/resource reference when
# any tool/resource module is part of the commit. Installed by
# tools/install-hooks.sh; opt-in (devs without the hook see no behavior change).
# To bypass for a single commit: git commit --no-verify

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
GENERATOR="${REPO_ROOT}/tools/generate_docs_reference.py"
cd "$REPO_ROOT"

if [[ ! -f "$GENERATOR" ]]; then
  echo "pre-commit: $GENERATOR missing; skipping docs regeneration." >&2
  exit 0
fi

relevant_paths='^Server/src/services/(tools|resources|registry)/'

# Include removals and the old paths of moves so obsolete pages are regenerated.
staged=$(git diff --cached --name-only --no-renames)

if ! grep -qE "$relevant_paths" <<<"$staged"; then
  exit 0
fi

# Generation reads the working tree. Require it to match the index for inputs
# and reference pages, including preserved authored examples, before any writes.
# This deliberately rejects partial staging instead of committing unstaged work.
generation_inputs=(
  Server/src
  tools/generate_docs_reference.py
  tools/cli_reference.py
  tools/cli_example_validation.py
  mcp_source.py
  website/docs/reference
)
if ! git diff --quiet -- "${generation_inputs[@]}" ||
  [[ -n "$(git ls-files --others --exclude-standard -- "${generation_inputs[@]}")" ]]; then
  echo "pre-commit: unstaged reference inputs or pages; stage or stash them before regenerating." >&2
  exit 1
fi

echo "pre-commit: tool/resource module changes detected — regenerating /website/docs/reference/"

# Prefer uv if available (matches how the Server's deps are pinned). Fall back
# to system python — the generator handles its own sys.path setup.
if command -v uv >/dev/null 2>&1 && [[ -f "${REPO_ROOT}/Server/pyproject.toml" ]]; then
  (cd "${REPO_ROOT}/Server" && uv run python "$GENERATOR")
else
  python3 "$GENERATOR"
fi

# The preflight guarantees that these deltas belong to this generator run.
# Limit ownership to its output paths, and include new pages and deletions.
generated_outputs=(
  website/docs/reference/tools
  website/docs/reference/resources
  website/docs/reference/cli-commands.md
)
generated_changes=()
while IFS= read -r -d '' path; do
  generated_changes+=("$path")
done < <(git diff --name-only -z -- "${generated_outputs[@]}")
while IFS= read -r -d '' path; do
  generated_changes+=("$path")
done < <(git ls-files --others --exclude-standard -z -- "${generated_outputs[@]}")
if (( ${#generated_changes[@]} )); then
  echo "pre-commit: staging regenerated reference pages."
  git add -A -- "${generated_changes[@]}"
fi

exit 0
