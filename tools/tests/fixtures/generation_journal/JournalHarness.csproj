<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="JournalHarness.cs" />
    <Compile Include="../../../../MCPForUnity/Editor/Services/AssetGen/AssetGenJobJournal.cs" />
    <Compile Include="../../../../MCPForUnity/Editor/Services/AssetGen/AssetGenJobCheckpoint.cs" />
    <Compile Include="../../../../MCPForUnity/Editor/Helpers/ExclusiveFileLease.cs" />
    <Compile Include="../../../../MCPForUnity/Editor/Helpers/AtomicAssetFile.cs" />
    <Compile Include="../../../../MCPForUnity/Editor/Helpers/AtomicFilePublication.cs" />
    <Compile Include="../../../../MCPForUnity/Runtime/Helpers/SafePathUtility.cs" />
    <!-- Reuse the SDK's existing JSON assembly; no extra package installation. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MSBuildSDKsPath)/../Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
