<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>0436</NoWarn>
    <KeyStoreSourceRoot Condition="'$(KeyStoreSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../../../MCPForUnity/Editor/Security/SecureKeyStore</KeyStoreSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LifecycleHarness.cs" />
    <Compile Include="$(KeyStoreSourceRoot)/MacKeychainKeyStore.cs" />
    <Compile Include="$(KeyStoreSourceRoot)/LinuxSecretToolKeyStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../../MCPForUnity/Editor/Security/SecureKeyStore/ISecureKeyStore.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../../MCPForUnity/Editor/Security/SecureKeyStore/SecureKeyStoreConstants.cs" />
    <Compile Include="$(KeyStoreSourceRoot)/KeyStoreProcess.cs" Condition="Exists('$(KeyStoreSourceRoot)/KeyStoreProcess.cs')" />
  </ItemGroup>
</Project>
