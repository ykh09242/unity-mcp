<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../../../tools/compile-refs/unity-analyzers.globalconfig" Link="unity-analyzers.globalconfig" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../MCPForUnity/Editor/ScriptDiagnosticsHost~/*.*" Link="host-source/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../../../MCPForUnity/Editor/Services/ScriptQuality/AnalysisHostProcess.cs" Link="AnalysisHostProcess.cs" />
    <Compile Include="../../../../MCPForUnity/Editor/Services/ScriptQuality/AnalysisHostInstallation.cs" Link="AnalysisHostInstallation.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <ProjectReference Include="../../../../MCPForUnity/Editor/ScriptDiagnosticsHost~/ScriptDiagnosticsHost.csproj" />
  </ItemGroup>
</Project>
