.setup-scroll {
    flex-grow: 1;
    min-height: 0;
    padding: 0 16px 12px 16px;
}

.setup-header {
    flex-direction: row;
    align-items: center;
    padding: 14px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
}

.setup-logo {
    width: 24px;
    height: 24px;
    margin-right: 10px;
    flex-shrink: 0;
}

.setup-header .title {
    margin: 0;
    flex-shrink: 1;
}

.dependency-item {
    padding: 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
}

.dependency-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: 24px;
}

.dependency-name {
    -unity-font-style: bold;
    flex-grow: 1;
    flex-basis: 140px;
    min-width: 100px;
}

.dependency-details {
    margin-top: 4px;
}

#status-message-container {
    margin-top: 12px;
}

#status-message {
    white-space: normal;
}

#installation-section {
    display: none;
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--mcp-border);
}

#installation-section.visible {
    display: flex;
}

.installation-container {
    min-width: 0;
}

.installation-title {
    -unity-font-style: bold;
    margin-bottom: 8px;
}

#installation-instructions {
    white-space: normal;
    margin-bottom: 8px;
}

.install-links-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.install-link-button {
    margin: 2px 6px 2px 0;
}

.button-container {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    padding-top: 12px;
}

.setup-button {
    min-width: 80px;
    margin: 4px 0 0 8px;
}

.setup-clients-list > .unity-toggle {
    min-height: 30px;
    padding: 4px 0;
}

.setup-clients-list .unity-toggle__text {
    white-space: normal;
    flex-shrink: 1;
}
