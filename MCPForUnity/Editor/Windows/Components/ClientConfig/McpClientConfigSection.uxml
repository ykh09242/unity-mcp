<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <ui:Style src="../Common.uss" />
    <ui:VisualElement name="client-section" class="section">
        <ui:Label text="AI client setup" class="section-title" />
        <ui:VisualElement class="section-content">
            <ui:Foldout name="client-details-foldout" text="Selected client" value="true" class="client-details-foldout">
                <ui:VisualElement class="setting-row">
                    <ui:Label text="Client:" class="setting-label" />
                    <ui:DropdownField name="client-dropdown" class="setting-dropdown-inline" />
                </ui:VisualElement>
                <ui:VisualElement class="setting-row">
                    <ui:VisualElement class="status-container">
                        <ui:VisualElement name="client-status-indicator" class="status-dot" />
                        <ui:Label name="client-status" text="Not Configured" class="status-text" />
                    </ui:VisualElement>
                    <ui:Button name="configure-button" text="Configure" class="action-button primary-button" />
                    <ui:Button name="install-skills-button" text="Install Skills" class="action-button initially-hidden" />
                </ui:VisualElement>
                <ui:VisualElement class="setting-row initially-hidden" name="claude-cli-path-row">
                    <ui:Label text="Claude CLI Path:" class="setting-label-small" />
                    <ui:TextField name="claude-cli-path" readonly="true" class="path-display-field" />
                    <ui:Button name="browse-claude-button" text="Browse" class="icon-button" />
                </ui:VisualElement>
                <ui:VisualElement class="setting-row initially-hidden" name="client-project-dir-row">
                    <ui:Label text="Client Project Dir:" class="setting-label-small" />
                    <ui:TextField name="client-project-dir" readonly="true" class="path-display-field" />
                    <ui:Button name="browse-project-dir-button" text="Browse" class="icon-button" />
                    <ui:Button name="clear-project-dir-button" text="Clear" class="icon-button" />
                </ui:VisualElement>
                <ui:Foldout name="client-review-foldout" text="Review configuration changes" value="false" class="settings-group">
                    <ui:VisualElement class="client-configuration-review">
                        <ui:Label text="Review a redacted Unity MCP entry change. Other settings are preserved." class="help-text" />
                        <ui:ScrollView name="configuration-preview-scroll" mode="Vertical" class="config-preview-scroll initially-hidden">
                            <ui:TextField name="configuration-preview" readonly="true" multiline="true" class="config-preview-field" />
                        </ui:ScrollView>
                        <ui:Label name="configuration-change-status" text="Choose Preview change to see what will be saved." class="help-text" />
                        <ui:VisualElement class="client-configuration-review-actions">
                            <ui:Button name="preview-configuration" text="Preview change" class="action-button" />
                            <ui:Button name="apply-configuration" text="Apply reviewed change" enabled="false" class="action-button primary-button initially-hidden" />
                            <ui:Button name="cancel-configuration-preview" text="Cancel preview" class="action-button initially-hidden" />
                            <ui:Button name="restore-configuration" text="Restore previous Unity entry" enabled="false" class="action-button initially-hidden" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:Foldout>
                <ui:Foldout name="manual-config-foldout" text="Manual Configuration" value="false" class="manual-config-foldout">
                    <ui:VisualElement class="manual-config-content">
                        <ui:Label text="Config Path:" class="config-label" />
                        <ui:VisualElement class="path-row">
                            <ui:TextField name="config-path" readonly="true" class="config-path-field" />
                            <ui:Button name="copy-path-button" text="Copy" class="icon-button" />
                            <ui:Button name="open-file-button" text="Open" class="icon-button" />
                        </ui:VisualElement>
                        <ui:Label name="config-path-status" class="help-text hidden" />
                        <ui:Label text="Configuration:" class="config-label" />
                        <ui:VisualElement class="config-json-row">
                            <ui:TextField name="config-json" readonly="true" multiline="true" class="config-json-field" />
                            <ui:Button name="copy-json-button" text="Copy" class="icon-button-vertical" />
                        </ui:VisualElement>
                        <ui:Label text="Installation Steps:" class="config-label" />
                        <ui:Label name="installation-steps" class="installation-steps" />
                    </ui:VisualElement>
                </ui:Foldout>
            </ui:Foldout>
            <ui:Foldout name="client-bulk-setup" text="Configure multiple clients" value="false" class="settings-group">
                <ui:Label text="Apply the current connection settings to all detected clients. Retry only the clients that failed." class="help-text" />
                <ui:VisualElement class="form-actions">
                    <ui:Button name="configure-all-button" text="Configure All Detected Clients" class="action-button" />
                    <ui:Button name="retry-failed-button" text="Retry Failed Clients" enabled="false" class="action-button" />
                </ui:VisualElement>
                <ui:Label name="retry-status" text="Uses current settings; successful clients are not changed." class="help-text" />
            </ui:Foldout>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
