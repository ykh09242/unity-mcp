.mcp-editor {
    --mcp-bg: var(--unity-colors-window-background, #383838);
    --mcp-surface: var(--unity-colors-toolbar-background, #3c3c3c);
    --mcp-field: var(--unity-colors-input_field-background, #2a2a2a);
    --mcp-hover: var(--unity-colors-button-background-hover, #676767);
    --mcp-text: var(--unity-colors-default-text, #d2d2d2);
    --mcp-muted: var(--unity-colors-label-text, #c4c4c4);
    --mcp-border: var(--unity-colors-default-border, #232323);
    --mcp-accent: var(--unity-colors-input_field-border-focus, #3a79bb);
    --mcp-accent-text: #ffffff;
    --mcp-danger: #f18e96;
    --mcp-success: #81d6a3;
    --mcp-warning: #ecc16f;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    font-size: 12px;
    letter-spacing: 0;
    color: var(--mcp-text);
    background-color: var(--mcp-bg);
}

.unity-theme-light .mcp-editor,
.mcp-editor.unity-theme-light {
    --mcp-bg: var(--unity-colors-window-background, #c8c8c8);
    --mcp-surface: var(--unity-colors-toolbar-background, #cbcbcb);
    --mcp-field: var(--unity-colors-input_field-background, #f0f0f0);
    --mcp-hover: var(--unity-colors-button-background-hover, #ececec);
    --mcp-text: var(--unity-colors-default-text, #090909);
    --mcp-muted: var(--unity-colors-label-text, #090909);
    --mcp-border: var(--unity-colors-default-border, #999999);
    --mcp-accent: var(--unity-colors-input_field-border-focus, #1d5087);
    --mcp-accent-text: #ffffff;
    --mcp-danger: #b12837;
    --mcp-success: #216d42;
    --mcp-warning: #845b08;
}

.mcp-editor .unity-base-field {
    min-width: 0;
}

.mcp-editor .unity-base-field__label {
    color: var(--mcp-text);
    white-space: normal;
    flex-shrink: 1;
}

.mcp-editor .unity-text-field__input,
.mcp-editor .unity-base-popup-field__input,
.mcp-editor .unity-enum-field__input {
    min-height: 24px;
    color: var(--mcp-text);
    background-color: var(--mcp-field);
    border-color: var(--mcp-border);
    border-radius: 3px;
}

.mcp-editor .unity-text-field__input:focus {
    border-color: var(--mcp-accent);
}

.title {
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 8px;
}

.section {
    padding: 16px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
    min-width: 0;
    flex-shrink: 0;
}

.section-title {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    white-space: normal;
}

.section-content {
    min-width: 0;
}

.setting-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
    min-height: 28px;
    min-width: 0;
}

.setting-column {
    margin-bottom: 8px;
    min-width: 0;
}

.setting-label {
    min-width: 140px;
    flex-shrink: 1;
    margin-right: 8px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.setting-label-small,
.override-label {
    min-width: 120px;
    flex-shrink: 1;
    margin-right: 8px;
    font-size: 11px;
    white-space: normal;
}

.setting-value {
    color: var(--mcp-muted);
    white-space: normal;
    flex-shrink: 1;
}

.setting-toggle {
    margin-left: auto;
    flex-shrink: 0;
}

.setting-dropdown-inline {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 150px;
    flex-basis: 200px;
}

.setting-dropdown {
    margin-top: 4px;
}

.validation-description,
.installation-steps {
    font-size: 11px;
    color: var(--mcp-muted);
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 6px;
}

.port-field {
    width: 100px;
    margin-left: auto;
}

.url-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 180px;
    flex-basis: 220px;
}

.status-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 8px;
}

.status-dot,
.status-indicator-small {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    flex-shrink: 0;
    background-color: var(--mcp-muted);
}

.status-dot {
    margin-right: 8px;
}

.status-indicator-small {
    margin-left: 8px;
}

.status-dot.connected,
.status-dot.configured,
.status-dot.healthy,
.status-indicator-small.valid {
    background-color: var(--mcp-success);
}

.status-dot.disconnected,
.status-dot.not-configured,
.status-indicator-small.invalid {
    background-color: var(--mcp-danger);
}

.status-dot.warning,
.status-indicator-small.warning {
    background-color: var(--mcp-warning);
}

.status-dot.unknown {
    background-color: var(--mcp-muted);
}

.status-text {
    flex-shrink: 1;
    white-space: normal;
}

.action-button,
.secondary-button,
.icon-button,
.icon-button-vertical,
.tool-action-button {
    min-height: 28px;
    height: auto;
    padding: 4px 10px;
    margin: 2px 0 2px 6px;
    border-width: 1px;
    border-color: var(--mcp-border);
    border-radius: 3px;
    background-color: var(--mcp-surface);
    color: var(--mcp-text);
    white-space: normal;
    flex-shrink: 0;
}

.action-button,
.secondary-button {
    min-width: 80px;
}

.action-button:hover,
.secondary-button:hover,
.icon-button:hover,
.icon-button-vertical:hover,
.tool-action-button:hover {
    background-color: var(--mcp-hover);
}

.action-button:focus,
.secondary-button:focus,
.icon-button:focus,
.icon-button-vertical:focus,
.tool-action-button:focus {
    border-color: var(--mcp-accent);
}

.action-button:disabled,
.secondary-button:disabled,
.icon-button:disabled,
.icon-button-vertical:disabled,
.tool-action-button:disabled {
    color: var(--mcp-muted);
    opacity: 0.55;
}

.start-server-button {
    margin-left: 0;
}

.action-button.server-running {
    color: var(--mcp-danger);
    border-color: var(--mcp-danger);
}

.primary-button {
    min-height: 32px;
    padding: 6px 12px;
    margin: 4px 0 8px 0;
    background-color: var(--mcp-accent);
    color: var(--mcp-accent-text);
    border-width: 1px;
    border-color: var(--mcp-accent);
    border-radius: 3px;
    -unity-font-style: bold;
    white-space: normal;
}

.primary-button:hover {
    opacity: 0.9;
}

.primary-button:focus {
    border-color: var(--mcp-text);
}

.primary-button:disabled {
    opacity: 0.5;
}

.client-details-foldout,
.manual-config-foldout,
.manual-command-foldout,
.advanced-settings-foldout {
    margin-top: 8px;
    margin-bottom: 4px;
}

.client-details-foldout > .unity-foldout__toggle,
.manual-config-foldout > .unity-foldout__toggle,
.manual-command-foldout > .unity-foldout__toggle,
.advanced-settings-foldout > .unity-foldout__toggle,
.catalog-category > .unity-foldout__toggle {
    min-height: 28px;
    -unity-font-style: bold;
}

.client-details-foldout > .unity-foldout__content,
.manual-config-foldout > .unity-foldout__content,
.manual-command-foldout > .unity-foldout__content {
    margin-top: 6px;
    margin-left: 0;
}

.manual-config-content,
.advanced-settings-content {
    margin-top: 8px;
    min-width: 0;
}

.config-label {
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 4px;
}

.path-row,
.path-override-controls,
.config-json-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
    min-width: 0;
}

.path-override-controls {
    margin-bottom: 12px;
}

.config-path-field,
.override-field,
.path-display-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 180px;
    min-width: 120px;
    margin-right: 4px;
}

.config-json-row {
    align-items: flex-start;
}

.config-json-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 240px;
    min-height: 80px;
    min-width: 160px;
    margin-right: 4px;
}

.config-json-field > .unity-text-field__input {
    font-size: 11px;
    white-space: normal;
}

.icon-button-vertical {
    align-self: flex-start;
}

.tool-actions,
.catalog-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
    min-width: 0;
}

.tool-action-button {
    margin-left: 0;
    margin-right: 6px;
}

.catalog-search {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 200px;
    min-width: 140px;
    margin: 0 8px 4px 0;
}

.catalog-count {
    color: var(--mcp-muted);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 4px;
}

.catalog-empty {
    padding: 16px 0;
    white-space: normal;
    color: var(--mcp-muted);
}

.catalog-group-warning {
    margin-top: 4px;
    margin-bottom: 8px;
}

.tool-category-container {
    margin-top: 8px;
}

.catalog-category {
    margin-bottom: 8px;
}

.tool-item {
    padding: 10px 8px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
    min-width: 0;
}

.tool-item-header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.tool-item-toggle {
    flex-shrink: 1;
    min-width: 0;
}

.tool-item-toggle .unity-toggle__text {
    white-space: normal;
    flex-shrink: 1;
}

.tool-tags {
    flex-direction: row;
    flex-wrap: wrap;
    margin-left: auto;
    padding-left: 8px;
}

.tool-tag {
    font-size: 10px;
    padding: 2px 6px;
    margin: 2px 0 0 4px;
    background-color: var(--mcp-surface);
    border-radius: 3px;
    color: var(--mcp-muted);
}

.tool-item-description,
.tool-parameters,
.help-text,
.advanced-label {
    font-size: 11px;
    color: var(--mcp-muted);
    white-space: normal;
    flex-shrink: 1;
    min-width: 0;
    margin-bottom: 4px;
}

.tool-item-description,
.tool-parameters {
    margin-top: 4px;
}

.group-header-checkbox {
    margin-left: 6px;
    margin-right: 0;
    flex-shrink: 0;
}

.override-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 4px;
}

.warning-banner {
    display: none;
    padding: 8px 12px;
    margin-bottom: 8px;
    background-color: var(--mcp-surface);
    border-left-width: 3px;
    border-left-color: var(--mcp-warning);
}

.warning-banner.visible {
    display: flex;
}

.warning-banner-text,
.status-warning {
    font-size: 11px;
    white-space: normal;
    color: var(--mcp-warning);
}

.help-text.http-local-url-error,
.status-error {
    color: var(--mcp-danger);
}

.status-success {
    color: var(--mcp-success);
}

.trailing-actions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.spaced-row {
    margin-top: 8px;
}

.compact-actions {
    margin-top: 4px;
    margin-bottom: 4px;
}

.subsection {
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--mcp-border);
}

.package-row {
    padding: 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
}

.package-name {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    -unity-font-style: bold;
}

.inline-status {
    margin-left: 8px;
    flex-grow: 1;
}

.endpoint-host {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 100px;
    flex-basis: 140px;
}

.endpoint-port {
    width: 70px;
    margin-left: 4px;
}

.hidden,
.initially-hidden,
.catalog-hidden {
    display: none;
}
