<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <ui:Style src="../Common.uss" />
    <ui:VisualElement name="advanced-section" class="section">
        <ui:Label text="Editor preferences" class="section-title" />
        <ui:VisualElement class="section-content">
            <ui:Label name="settings-user-scope" class="help-text section-intro" text="User scope: preferences and path overrides are shared across projects. Toggles save immediately; network and server changes apply to the next launch or reconnect. Output paths are resolved in the receiving project." />
            <ui:Foldout name="settings-diagnostics" text="Diagnostics" value="true" class="settings-group">
                <ui:Label text="Inspect connection health and control diagnostic output." class="help-text group-description" />
                <ui:VisualElement class="setting-row spaced-row">
                    <ui:Toggle name="debug-logs-toggle" class="field-toggle" text="Debug Logging" />
                </ui:VisualElement>
                <ui:VisualElement class="setting-row">
                    <ui:Toggle name="log-record-toggle" class="field-toggle" text="Log Record (Assets/mcp.log)" />
                </ui:VisualElement>
                <ui:VisualElement class="setting-row">
                    <ui:Label text="Server Health:" class="setting-label" />
                    <ui:VisualElement class="status-container">
                        <ui:VisualElement name="health-indicator" class="status-dot" />
                        <ui:Label name="health-status" text="Unknown" class="status-text" />
                    </ui:VisualElement>
                    <ui:Button name="test-connection-button" text="Test" class="action-button" />
                </ui:VisualElement>
            </ui:Foldout>
            <ui:Foldout name="settings-connection" text="Connection behavior" value="true" class="settings-group">
                <ui:Label text="User startup and network access preferences. Current sessions keep their existing connection until reconnected." class="help-text group-description" />
                <ui:VisualElement class="setting-row">
                    <ui:Toggle name="auto-start-on-load-toggle" class="field-toggle" text="Start HTTP on Editor Startup" />
                </ui:VisualElement>
                <ui:VisualElement class="setting-row">
                    <ui:Toggle name="allow-lan-http-bind-toggle" class="field-toggle" text="Allow LAN Bind (HTTP Local)" />
                </ui:VisualElement>
                <ui:VisualElement class="setting-row">
                    <ui:Toggle name="allow-insecure-remote-http-toggle" class="field-toggle" text="Allow Insecure Remote HTTP" />
                </ui:VisualElement>
            </ui:Foldout>
            <ui:Foldout name="settings-paths" text="Paths and output" value="true" class="settings-group">
                <ui:Label text="Leave overrides empty to use the detected defaults." class="help-text group-description" />
                <ui:VisualElement class="override-row">
                    <ui:Label text="UVX Path:" class="override-label" />
                    <ui:VisualElement class="status-indicator-small" name="uv-path-status" />
                </ui:VisualElement>
                <ui:VisualElement class="path-override-controls">
                    <ui:TextField name="uv-path-override" readonly="true" class="override-field" />
                    <ui:Button name="browse-uv-button" text="Browse" class="icon-button" />
                    <ui:Button name="clear-uv-button" text="Clear" class="icon-button" />
                </ui:VisualElement>
                <ui:VisualElement class="override-row">
                    <ui:Label text="Server Source:" class="override-label" />
                </ui:VisualElement>
                <ui:VisualElement class="path-override-controls">
                    <ui:TextField name="git-url-override" placeholder-text="/path/to/Server or git+https://..." class="override-field" />
                    <ui:Button name="browse-git-url-button" text="Select" class="icon-button" />
                    <ui:Button name="clear-git-url-button" text="Clear" class="icon-button" />
                </ui:VisualElement>
                <ui:VisualElement class="override-row">
                    <ui:Label text="Screenshots Folder:" class="override-label" />
                </ui:VisualElement>
                <ui:VisualElement class="path-override-controls">
                    <ui:TextField name="screenshots-folder-override" placeholder-text="Assets/Screenshots (default)" class="override-field" />
                    <ui:Button name="browse-screenshots-folder-button" text="Select" class="icon-button" />
                    <ui:Button name="clear-screenshots-folder-button" text="Clear" class="icon-button" />
                </ui:VisualElement>
            </ui:Foldout>
            <ui:Foldout name="settings-development" text="Development and package deployment" value="false" class="settings-group">
                <ui:Label text="Use these controls when developing or replacing the Unity MCP package." class="help-text group-description" />
                <ui:VisualElement class="setting-row">
                    <ui:Toggle name="dev-mode-force-refresh-toggle" class="field-toggle" text="Force Fresh Install" />
                </ui:VisualElement>
                <ui:Label name="settings-project-scope" text="Project: deployment source and targets belong to this project. Apply saves the source; Deploy changes the selected target." class="help-text" />
                <ui:VisualElement class="override-row">
                    <ui:Label text="Package Source:" class="override-label" />
                </ui:VisualElement>
                <ui:VisualElement class="path-override-controls">
                    <ui:TextField name="deploy-source-path" class="override-field" />
                    <ui:Button name="apply-deploy-source-button" text="Apply source" class="icon-button" />
                    <ui:Button name="browse-deploy-source-button" text="Select" class="icon-button" />
                    <ui:Button name="clear-deploy-source-button" text="Clear" class="icon-button" />
                </ui:VisualElement>
                <ui:Label name="deploy-target-label" class="help-text" />
                <ui:Label name="deploy-backup-label" class="help-text" />
                <ui:VisualElement class="path-override-controls compact-actions">
                    <ui:Button name="deploy-button" text="Deploy" class="icon-button" />
                    <ui:Button name="deploy-restore-button" text="Restore" class="icon-button" />
                </ui:VisualElement>
                <ui:Label name="deploy-status-label" class="help-text" />
            </ui:Foldout>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
