<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <ui:Style src="../Common.uss" />
    <ui:VisualElement name="assetgen-section" class="section">
        <ui:Label text="Generation defaults" class="section-title" />
        <ui:VisualElement class="section-content">
            <ui:Label name="assetgen-help" class="help-text" text="Configure providers here; generate assets through MCP tools or CLI." />
            <ui:Label name="generation-scope" class="help-text" text="User scope · defaults and enablement save immediately for future requests across projects. Output Root saves after validation; paths use the receiving project." />
            <ui:VisualElement name="gltfast-notice" class="warning-banner">
                <ui:Label class="warning-banner-text" text="GLB import needs the glTFast package — install it from the Dependencies tab." />
                <ui:Button name="assetgen-open-dependencies" text="Review glTFast dependency" class="action-button" />
            </ui:VisualElement>
            <ui:VisualElement class="setting-row">
                <ui:Button name="assetgen-refresh" text="Refresh All" class="icon-button" />
                <ui:Label name="assetgen-refresh-status" class="help-text" />
            </ui:VisualElement>
            <ui:VisualElement name="assetgen-providers-container" class="spaced-row" />
            <ui:Foldout name="blender-setup-foldout" text="Blender connection and import" value="false" class="settings-group">
                <ui:VisualElement name="blender-bridge-panel" class="subsection">
                    <ui:VisualElement class="setting-row">
                        <ui:Label text="Blender Bridge" class="section-title" />
                        <ui:VisualElement name="blender-status-dot" class="status-indicator-small" />
                        <ui:Label name="blender-status-label" class="help-text inline-status" />
                    </ui:VisualElement>
                    <ui:VisualElement class="setting-row">
                        <ui:TextField label="Host" name="blender-host" class="endpoint-host labeled-endpoint" />
                        <ui:TextField label="Port" name="blender-port" class="endpoint-port labeled-endpoint" />
                        <ui:Button name="blender-test-button" text="Test Connection" class="icon-button" />
                    </ui:VisualElement>
                    <ui:VisualElement class="override-row">
                        <ui:Label text="blender-mcp Checkout (optional):" class="override-label" />
                    </ui:VisualElement>
                    <ui:Label name="blender-fork-help" class="help-text" />
                    <ui:VisualElement class="path-override-controls">
                        <ui:TextField name="blender-fork-path" placeholder-text="/path/to/blender-mcp (contains addon.py)" class="override-field" />
                        <ui:Button name="blender-fork-select-button" text="Select" class="icon-button" />
                        <ui:Button name="blender-fork-clear-button" text="Clear" class="icon-button" />
                    </ui:VisualElement>
                    <ui:VisualElement class="override-row">
                        <ui:Label text="Blender Addons Dir:" class="override-label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="path-override-controls">
                        <ui:TextField name="blender-addons-dir" placeholder-text="auto-detect newest Blender user addons folder" class="override-field" />
                        <ui:Button name="blender-addons-select-button" text="Select" class="icon-button" />
                        <ui:Button name="blender-addons-clear-button" text="Clear" class="icon-button" />
                    </ui:VisualElement>
                    <ui:Label name="blender-addons-resolved" class="help-text" />
                    <ui:VisualElement class="path-override-controls compact-actions">
                        <ui:Button name="blender-sync-button" text="Sync Addon" class="icon-button" />
                        <ui:Button name="blender-updates-button" text="Check Updates" class="icon-button" />
                        <ui:Button name="blender-import-button" text="Import Blender Selection (GLB)" class="icon-button" />
                    </ui:VisualElement>
                    <ui:Label name="blender-action-status" class="help-text" />
                    <ui:Button name="blender-consent-settings" text="Review Blender consent in Tools" class="icon-button catalog-hidden" />
                    <ui:Foldout text="Operation details" value="false">
                        <ui:Label name="blender-action-details" class="help-text" />
                    </ui:Foldout>
                </ui:VisualElement>
            </ui:Foldout>
            <ui:Foldout name="assetgen-import-foldout" text="Import preferences" value="false" class="settings-group">
                <ui:VisualElement class="setting-row">
                    <ui:Label text="Default 3D Format:" class="setting-label" />
                    <ui:DropdownField name="assetgen-format-dropdown" class="setting-dropdown-inline" />
                </ui:VisualElement>
                <ui:VisualElement class="override-row">
                    <ui:Label text="Output Root:" class="override-label" />
                </ui:VisualElement>
                <ui:VisualElement class="path-override-controls">
                    <ui:TextField name="assetgen-output-root" placeholder-text="Assets/Generated" class="override-field" />
                </ui:VisualElement>
                <ui:Label name="assetgen-output-validation" class="warning-banner-text" />
                <ui:Label name="assetgen-output-effective" class="help-text" />
                <ui:VisualElement class="setting-row">
                    <ui:Toggle name="assetgen-auto-normalize" class="field-toggle" text="Normalize imported models" />
                </ui:VisualElement>
            </ui:Foldout>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
