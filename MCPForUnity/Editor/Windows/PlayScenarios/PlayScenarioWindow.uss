.play-scenarios {
    padding: 8px;
}
.scenario-heading {
    font-size: 18px;
    -unity-font-style: bold;
    min-height: 24px;
    flex-shrink: 0;
}
.scenario-draft-context {
    min-height: 20px;
    flex-shrink: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.scenario-columns {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    margin-top: 4px;
}
.scenario-panel {
    display: none;
    flex-grow: 1;
    flex-shrink: 1;
    background-color: var(--mcp-surface);
    border-width: 1px;
    border-color: var(--mcp-border);
    border-radius: 4px;
    padding: 8px;
    min-width: 0;
    min-height: 0;
}
.scenario-pane-active { display: flex; }
.scenario-row.scenario-tabs { flex-shrink: 0; flex-wrap: nowrap; }
.scenario-tabs > .scenario-tab { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 28px; white-space: normal; }
.scenario-tab-selected { border-bottom-width: 2px; border-bottom-color: var(--mcp-accent); -unity-font-style: bold; }
.scenario-row.scenario-active-run { display: none; flex-wrap: nowrap; }
.scenario-row.scenario-active-run-visible { display: flex; }
.scenario-active-run-label { flex-grow: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.scenario-run-finished #cancelScenario { display: none; }
.scenario-primary-button { background-color: var(--mcp-accent); color: var(--mcp-accent-text); border-color: var(--mcp-accent); -unity-font-style: bold; }
#scenarioEditorScroll, #scenarioAuthoring, #scenarioSteps { min-width: 0; }
.scenario-authoring { flex-shrink: 0; }
.scenario-editor .unity-base-field, .scenario-run .unity-base-field { min-width: 0; flex-shrink: 0; }
.scenario-compact .scenario-editor .unity-base-field,
.scenario-compact .scenario-run .unity-base-field { flex-direction: column; }
.scenario-compact .scenario-editor .unity-base-field__label,
.scenario-compact .scenario-run .unity-base-field__label { min-width: 0; margin-bottom: 3px; }
.scenario-optional-group { margin-top: 8px; padding-top: 6px; border-top-width: 1px; border-top-color: var(--mcp-border); flex-shrink: 0; min-width: 0; }
.scenario-editor .unity-foldout { flex-shrink: 0; min-width: 0; }
.scenario-editor .unity-foldout__toggle, .scenario-run .unity-foldout__toggle { min-height: 24px; flex-shrink: 0; }
.scenario-results-tools { flex-shrink: 0; min-width: 0; }
.scenario-results-tools > .unity-foldout__content { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.scenario-results-evidence-open .scenario-current-report { display: none; }
.scenario-results-evidence-open .scenario-results-tools { flex-grow: 1; min-height: 0; }
.scenario-evidence-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; min-width: 0; }
.scenario-short .scenario-heading, .scenario-short .scenario-intro, .scenario-short .scenario-section-title { display: none; }
.scenario-short.play-scenarios { padding: 4px; }
.scenario-short .scenario-row { margin-top: 1px; margin-bottom: 1px; }
.scenario-short .scenario-tabs > .scenario-tab { min-height: 24px; margin-top: 0; margin-bottom: 0; }
.scenario-short .scenario-draft-context { min-height: 18px; }
.scenario-short .scenario-panel { padding: 4px; }
.scenario-short .scenario-scroll { margin-top: 2px; }
.scenario-short .scenario-active-run > Button { min-height: 20px; margin-top: 0; margin-bottom: 0; }
.scenario-short .scenario-message { display: none; }
.scenario-short .scenario-message.scenario-error { display: flex; white-space: nowrap; text-overflow: ellipsis; min-height: 16px; max-height: 16px; margin-top: 0; }
.scenario-short .scenario-results-tools > .unity-foldout__toggle { min-height: 20px; margin-top: 0; margin-bottom: 0; }
.scenario-section-title {
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 6px;
    flex-shrink: 0;
    white-space: normal;
}
.scenario-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 4px;
}
.scenario-row > Button {
    margin-left: 0;
    margin-right: 4px;
    min-height: 26px;
    white-space: normal;
}
.scenario-copy-name {
    flex-grow: 1;
    min-width: 120px;
}
.scenario-note {
    color: var(--mcp-muted);
    white-space: normal;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
}
.scenario-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
    margin-top: 6px;
}
.scenario-scroll .unity-scroll-view__content-container {
    padding-right: 4px;
}
.scenario-list-item {
    min-height: 28px;
    white-space: normal;
    -unity-text-align: middle-left;
    margin: 2px 0;
}
.scenario-selected {
    border-color: var(--mcp-accent);
    border-width: 1px;
}
.scenario-step {
    background-color: var(--mcp-bg);
    border-color: var(--mcp-border);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px;
    margin-bottom: 8px;
    flex-shrink: 0;
}
.scenario-step-number { flex-grow: 1; -unity-font-style: bold; white-space: nowrap; }
.scenario-step .unity-base-field__label {
    min-width: 112px;
}
.scenario-validation {
    white-space: normal;
    color: var(--mcp-success);
    margin-top: 4px;
    flex-shrink: 0;
}
.scenario-error {
    color: var(--mcp-danger);
}
.scenario-result-row {
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
    padding-bottom: 6px;
    margin-bottom: 6px;
}
.scenario-message {
    white-space: normal;
    min-height: 18px;
    max-height: 48px;
    overflow: hidden;
    margin-top: 4px;
    flex-shrink: 0;
}
.scenario-message-empty { display: none; }

.scenario-history-comparison {
    max-height: 220px;
    min-height: 0;
}

.scenario-soak-chart {
    height: 160px;
    flex-shrink: 0;
    background-color: var(--mcp-bg);
    margin-top: 6px;
    margin-bottom: 6px;
}

.scenario-soak-comparison-scroll {
    max-height: 400px;
    min-height: 196px;
    flex-shrink: 0;
}

.scenario-soak-source-state {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-height: 20px;
}

.scenario-soak-metadata-scroll {
    height: 140px;
    min-height: 140px;
    flex-shrink: 0;
}

.scenario-soak-comparison {
    min-height: 24px;
    flex-shrink: 1;
}

.scenario-soak-comparison > .unity-foldout__content {
    min-height: 0;
    flex-shrink: 1;
}

.scenario-suite-editor .unity-base-field {
    flex-direction: column;
    align-items: stretch;
}
.scenario-suite-editor Label,
#scenarioAuthoring Label {
    white-space: normal;
}
.scenario-suite-editor .unity-base-field__label {
    min-width: 0;
}
.scenario-suite-lines .unity-text-field__input {
    min-height: 64px;
}
