.play-scenarios {
    padding: 12px;
}
.scenario-heading {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}
.scenario-columns {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    margin-top: 8px;
}
.scenario-panel {
    background-color: var(--mcp-surface);
    border-width: 1px;
    border-color: var(--mcp-border);
    border-radius: 4px;
    padding: 8px;
    min-width: 0;
}
.scenario-library { min-width: 150px; }
.scenario-editor { min-width: 280px; }
.scenario-results { min-width: 280px; }
.scenario-split { flex-grow: 1; min-width: 0; min-height: 0; }
.scenario-tabs { display: none; }
.scenario-compact .scenario-tabs { display: flex; }
.scenario-tab { flex-grow: 1; min-height: 28px; }
.scenario-tab-selected { border-bottom-width: 2px; border-bottom-color: var(--mcp-accent); -unity-font-style: bold; }
.scenario-compact .scenario-panel { min-width: 0; flex-grow: 1; flex-shrink: 1; }
.scenario-primary-actions { flex-shrink: 0; }
.scenario-short .scenario-heading, .scenario-short .scenario-intro { display: none; }
.scenario-short.play-scenarios { padding: 8px; }
.scenario-short .scenario-message { min-height: 0; margin-top: 4px; }
#scenarioEditorScroll, #scenarioAuthoring, #scenarioSteps { min-width: 0; }
#scenarioEditorScroll .unity-base-field { min-width: 0; }
.scenario-compact #scenarioEditorScroll .unity-base-field { flex-direction: column; }
.scenario-compact #scenarioEditorScroll .unity-base-field__label { min-width: 0; margin-bottom: 3px; }
.scenario-section-title {
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 8px;
}
.scenario-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
}
.scenario-row > Button {
    margin-left: 0;
    margin-right: 4px;
    min-height: 24px;
}
.scenario-copy-name {
    flex-grow: 1;
    min-width: 120px;
}
.scenario-note {
    color: var(--mcp-muted);
    white-space: normal;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
}
.scenario-scroll {
    flex-grow: 1;
    min-height: 0;
    margin-top: 6px;
}
.scenario-scroll .unity-scroll-view__content-container {
    padding-right: 4px;
}
.scenario-list-item {
    min-height: 28px;
    white-space: normal;
    -unity-text-align: middle-left;
    margin: 2px 0;
}
.scenario-selected {
    border-color: var(--mcp-accent);
    border-width: 1px;
}
.scenario-step {
    background-color: var(--mcp-bg);
    border-color: var(--mcp-border);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px;
    margin-bottom: 8px;
    flex-shrink: 0;
}
.scenario-step .unity-base-field__label {
    min-width: 112px;
}
.scenario-validation {
    white-space: normal;
    color: var(--mcp-success);
    margin-top: 4px;
    flex-shrink: 0;
}
.scenario-error {
    color: var(--mcp-danger);
}
.scenario-result-row {
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
    padding-bottom: 6px;
    margin-bottom: 6px;
}
.scenario-message {
    white-space: normal;
    min-height: 20px;
    margin-top: 8px;
    flex-shrink: 0;
}

.scenario-history-comparison {
    max-height: 220px;
    min-height: 0;
}

.scenario-soak-chart {
    height: 160px;
    flex-shrink: 0;
    background-color: var(--mcp-bg);
    margin-top: 6px;
    margin-bottom: 6px;
}

.scenario-soak-comparison-scroll {
    max-height: 400px;
    min-height: 196px;
    flex-shrink: 0;
}

.scenario-results-scroll {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}

.scenario-results-scroll #runResults {
    min-height: 60px;
    max-height: 220px;
    flex-grow: 0;
    flex-shrink: 0;
}

.scenario-soak-source-state {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-height: 20px;
}

.scenario-soak-metadata-scroll {
    height: 140px;
    min-height: 140px;
    flex-shrink: 0;
}

.scenario-soak-comparison {
    min-height: 24px;
    flex-shrink: 1;
}

.scenario-soak-comparison > .unity-foldout__content {
    min-height: 0;
    flex-shrink: 1;
}

.scenario-suite-editor .unity-base-field {
    flex-direction: column;
    align-items: stretch;
}
.scenario-suite-editor Label,
#scenarioAuthoring Label {
    white-space: normal;
}
.scenario-suite-editor .unity-base-field__label {
    min-width: 0;
}
.scenario-suite-lines .unity-text-field__input {
    min-height: 64px;
}
