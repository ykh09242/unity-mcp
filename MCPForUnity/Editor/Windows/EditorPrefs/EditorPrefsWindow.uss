.editor-prefs-window {
    flex-grow: 1;
    min-height: 0;
    padding: 12px;
    background-color: var(--mcp-bg);
    color: var(--mcp-text);
}

.editor-prefs-window .prefs-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.editor-prefs-window .prefs-title {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
}

.editor-prefs-window .prefs-count {
    color: var(--mcp-muted);
    margin-right: 4px;
}

.editor-prefs-window .prefs-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.editor-prefs-window .prefs-search {
    flex-grow: 1;
    min-width: 0;
    margin-left: 0;
}

.editor-prefs-window .prefs-search > .unity-base-field__label {
    min-width: 52px;
    width: 52px;
}

.editor-prefs-window .prefs-refresh {
    width: 28px;
    height: 28px;
    padding: 0;
    margin-left: 6px;
    font-size: 16px;
}

.editor-prefs-window .prefs-scroll {
    flex-grow: 1;
    min-height: 0;
    border-top-width: 1px;
    border-top-color: var(--mcp-border);
}

.editor-prefs-window .pref-item {
    padding: 8px 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
}

.editor-prefs-window .key-section {
    margin-bottom: 4px;
    min-width: 0;
}

.editor-prefs-window .key-label {
    color: var(--mcp-text);
    white-space: normal;
    -unity-font-style: bold;
    margin-left: 0;
}

.editor-prefs-window .pref-row,
.editor-prefs-window .add-row-content {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.editor-prefs-window .value-field,
.editor-prefs-window .key-field {
    flex-grow: 1;
    flex-basis: 260px;
    min-width: 180px;
    margin-left: 0;
    margin-right: 6px;
}

.editor-prefs-window .type-dropdown {
    width: 84px;
    flex-shrink: 0;
    margin-right: 6px;
}

.editor-prefs-window .action-buttons,
.editor-prefs-window .add-buttons {
    flex-direction: row;
    flex-shrink: 0;
}

.editor-prefs-window .action-buttons .save-button {
    width: 28px;
    height: 28px;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
}

.editor-prefs-window .save-button {
    background-color: var(--mcp-accent);
    color: var(--mcp-accent-text);
}

.editor-prefs-window .save-button:hover {
    background-color: var(--mcp-hover);
    color: var(--mcp-text);
}

.editor-prefs-window .unity-base-field__input {
    min-width: 0;
    background-color: var(--mcp-field);
    color: var(--mcp-text);
    border-color: var(--mcp-border);
}

.editor-prefs-window .pref-unset {
    opacity: 0.6;
}

.editor-prefs-window .prefs-empty {
    color: var(--mcp-muted);
    padding: 16px 4px;
    white-space: normal;
}

.editor-prefs-window .pref-hidden {
    display: none;
}
