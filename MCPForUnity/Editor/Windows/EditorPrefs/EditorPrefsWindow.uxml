<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="../Components/Common.uss" />
    <Style src="EditorPrefsWindow.uss" />
    <ui:VisualElement class="editor-prefs-window">
        <ui:VisualElement class="prefs-header">
            <ui:Label text="EditorPrefs" class="prefs-title" />
            <ui:Label name="result-count" class="prefs-count" />
        </ui:VisualElement>
        <ui:VisualElement class="prefs-toolbar">
            <ui:TextField name="search-field" label="Search" class="prefs-search" tooltip="Filter preference keys" />
            <ui:Button name="refresh-button" text="↻" class="prefs-refresh" tooltip="Reload preferences" />
        </ui:VisualElement>
        <ui:ScrollView name="scroll-view" mode="Vertical" class="prefs-scroll">
            <ui:VisualElement name="add-new-row" class="add-new-row pref-hidden">
                <ui:VisualElement class="add-row-content">
                    <ui:TextField name="new-key-field" label="Key" class="key-field" />
                    <ui:TextField name="new-value-field" label="Value" class="value-field" />
                    <ui:DropdownField name="new-type-dropdown" label="Type" class="type-dropdown" choices="String,Int,Float,Bool" index="0" />
                    <ui:VisualElement class="add-buttons">
                        <ui:Button name="create-button" text="Create" class="save-button" />
                        <ui:Button name="cancel-button" text="Cancel" class="cancel-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="prefs-container" class="prefs-container" />
            <ui:Label name="empty-state" class="prefs-empty pref-hidden" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
