#root-container.root-layout {
    padding: 0;
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

.header-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    min-height: 44px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
}

.header-left {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
}

.header-logo {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    flex-shrink: 0;
}

.header-title {
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}

.header-version {
    font-size: 11px;
    color: var(--mcp-muted);
    flex-shrink: 0;
    margin-left: 12px;
}

.update-notification {
    display: none;
    padding: 8px 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
    border-left-width: 3px;
    border-left-color: var(--mcp-success);
    flex-shrink: 0;
}

.update-notification.visible {
    display: flex;
}

.update-notification-text {
    font-size: 11px;
    color: var(--mcp-success);
    white-space: normal;
    flex-shrink: 1;
}

.tab-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding: 0 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
    background-color: var(--mcp-surface);
}

.navigation-tab {
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 80px;
    min-width: 80px;
    min-height: 32px;
    height: auto;
    margin: 0;
    padding: 6px 8px;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    border-radius: 0;
    background-color: transparent;
    color: var(--mcp-muted);
    -unity-text-align: middle-center;
}

.navigation-tab:hover {
    background-color: var(--mcp-hover);
    color: var(--mcp-text);
}

.navigation-tab:checked {
    border-bottom-color: var(--mcp-accent);
    background-color: var(--mcp-bg);
    color: var(--mcp-text);
    -unity-font-style: bold;
}

.navigation-tab:focus {
    border-bottom-color: var(--mcp-accent);
}

.panel-scroll {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    padding: 0 16px;
}

.panel-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding-bottom: 12px;
}

.section-stack {
    min-width: 0;
}
