#root-container.root-layout {
    padding: 0;
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

.header-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    min-height: 44px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
}

.header-left {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
}

.header-logo {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    flex-shrink: 0;
}

.header-title {
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}

.header-version {
    font-size: 11px;
    color: var(--mcp-muted);
    flex-shrink: 0;
    margin-left: 12px;
}

.update-notification {
    display: none;
    padding: 8px 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
    border-left-width: 3px;
    border-left-color: var(--mcp-success);
    flex-shrink: 0;
}

.update-notification.visible {
    display: flex;
}

.update-notification-text {
    font-size: 11px;
    color: var(--mcp-success);
    white-space: normal;
    flex-shrink: 1;
}

.window-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}

.navigation-scroll {
    width: 164px;
    min-height: 0;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: var(--mcp-border);
    background-color: var(--mcp-surface);
}

.tab-toolbar { padding: 12px 8px; }

.navigation-group {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--mcp-muted);
    margin: 0 10px 8px 10px;
}

.navigation-group-spaced { margin-top: 20px; }

.navigation-tab {
    flex-shrink: 0;
    min-height: 32px;
    height: auto;
    margin: 0 0 4px 0;
    padding: 7px 10px;
    border-width: 1px;
    border-color: transparent;
    border-left-width: 3px;
    border-radius: 3px;
    background-color: transparent;
    color: var(--mcp-muted);
    -unity-text-align: middle-left;
}

.navigation-tab:hover {
    background-color: var(--mcp-hover);
    color: var(--mcp-text);
}

.navigation-tab:checked {
    border-left-color: var(--mcp-accent);
    background-color: var(--mcp-field);
    color: var(--mcp-text);
    -unity-font-style: bold;
}

.navigation-tab:focus { border-color: var(--mcp-accent); }

.page-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.page-header {
    flex-shrink: 0;
    padding: 16px 20px 12px 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--mcp-border);
}

.page-title { font-size: 20px; -unity-font-style: bold; margin-bottom: 5px; }
.page-description { color: var(--mcp-muted); white-space: normal; }
.compact-page-navigation { display: none; padding: 8px 14px; flex-shrink: 0; }
.page-selector { flex-grow: 1; min-width: 0; }
.page-selector > .unity-base-field__label { min-width: 0; width: 44px; }
.compact-navigation .compact-page-navigation { display: flex; }
.compact-navigation .navigation-scroll { display: none; }
.compact-navigation .page-header { padding: 10px 16px; }
.compact-navigation .page-title { font-size: 18px; }

.panel-scroll {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    padding: 0 20px;
}

.panel-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding-bottom: 12px;
}

.section-stack {
    min-width: 0;
}

.activity-section { min-width: 0; padding-top: 12px; }
.activity-note { white-space: normal; margin-top: 3px; margin-bottom: 4px; min-width: 0; }
.activity-card { padding: 12px; margin-top: 8px; margin-bottom: 6px; background-color: var(--mcp-surface); border-left-width: 3px; border-left-color: var(--mcp-border); }
.activity-title { -unity-font-style: bold; }
.activity-actions { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.activity-actions Button { margin-right: 8px; margin-bottom: 4px; min-height: 28px; }
#activity-retention { margin-top: 12px; color: var(--mcp-muted); }

.compact-navigation .panel-scroll { padding-left: 16px; padding-right: 16px; }

.activity-state { -unity-font-style: bold; margin-top: 6px; }
.activity-id { color: var(--mcp-muted); font-size: 10px; }
.activity-active { border-left-color: var(--mcp-accent); }
#activity-empty { padding: 20px 12px; margin-top: 12px; background-color: var(--mcp-surface); }

/* The page selector/sidebar already identifies the page in short docked windows. */
.compact-height .header-bar { min-height: 28px; padding-top: 3px; padding-bottom: 3px; }
.compact-height .header-logo { width: 20px; height: 20px; }
.compact-height .page-header { display: none; }
.compact-height .compact-page-navigation { padding-top: 4px; padding-bottom: 4px; }
.compact-height .graph-heading { display: none; }

.activity-filters { flex-direction: row; flex-wrap: wrap; }
.activity-filters .unity-base-field { flex-grow: 1; flex-basis: 200px; min-width: 0; margin-right: 8px; margin-bottom: 6px; }
.activity-selected { border-left-color: var(--mcp-accent); }
#activity-selected-summary { background-color: var(--mcp-surface); padding: 10px; }
#activity-page { align-self: center; margin-right: 8px; margin-bottom: 4px; white-space: normal; }
